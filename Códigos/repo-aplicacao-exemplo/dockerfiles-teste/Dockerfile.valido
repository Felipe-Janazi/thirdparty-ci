# ============================================================
# CENARIO 1 - VALIDO (o pipeline deve PASSAR)
# ============================================================
# Este Dockerfile so entrega um artefato ja pronto (app.jar).
# Nenhum comando de build de aplicacao e executado aqui.
#
# COMO TESTAR:
#   cp dockerfiles-teste/Dockerfile.valido Dockerfile
#   git add Dockerfile && git commit -m "teste: cenario valido" && git push
# Resultado esperado: job "validate-dockerfile" passa (verde).
# ============================================================

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Apenas copia o artefato ja compilado para dentro da imagem.
COPY artifacts/app.jar ./app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
