# ============================================================
# CENARIO 3 - INVALIDO (o pipeline deve BLOQUEAR)
# ============================================================
# Este Dockerfile faz build de um frontend dentro do container
# (RUN npm ci && npm run build), o que tambem viola a regra.
#
# COMO TESTAR:
#   cp dockerfiles-teste/Dockerfile.invalido-npm Dockerfile
#   git add Dockerfile && git commit -m "teste: cenario invalido npm" && git push
# Resultado esperado: job "validate-dockerfile" falha com a mesma
# mensagem de bloqueio do cenario com mvn.
# ============================================================

FROM node:20-alpine AS build

WORKDIR /src
COPY . .

# Este comando deve ser detectado e bloqueado pelo job validate-dockerfile
RUN npm ci && npm run build

FROM nginx:alpine
COPY --from=build /src/dist /usr/share/nginx/html
